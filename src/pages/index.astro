---
import { getEntry, getCollection, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PublicationDate from "../components/PublicationDate.astro";

async function getRenderedEntry(name: string) {
  const entry = await getEntry("about", name);
  if (!entry) {
    throw new Error("Missing 'about' markdown entry.");
  }
  return await render(entry);
}
var { Content } = await getRenderedEntry("about");

async function pickQuote() {
  let quotes = [
    '"The only thing that could go wrong."',
    '"The one person I would pick if I had to get marooned on a desert island with someone."',
    '"The dad from a picturesque Disney family, but like, from the start of the movie before the wife dies."',
    '"The good kind of insane."',
    '"I think you radiate \'forklift certified\'."',
    '"Applied Philosopher"',
    '"Recovery Tool"',
    '"Both the confidence to try something unconventional, and the writing chops to pull it off."',
    '"You get the impression he really cares."'
  ];

  return quotes[Math.floor(Math.random() * quotes.length)];
}

const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf()
);
---

<PageLayout title="Andrew Brown" description="A website for my (mis)adventures.">
  <Fragment slot="header"><span class="quote">{ pickQuote() }</span></Fragment>
  <h2 id="about"><a class="heading-linker" href="#about">About Me</a></h2>
  <Content />
  <h3 id="this"><a class="heading-linker" href="#this">About This</a></h2>
  { console.log(JSON.stringify(({ Content } = await getRenderedEntry("this")))) }
  <Content />
  <h2 id="content"><a class="heading-linker" href="#content">Postings</a></h2>
  <div class="article-grid">
    {
      articles.map((article) => (
        <article>
          <header>
          <!-- { article.data.cover && article.data.coverAlt && <Image src={article.data.cover} alt={article.data.coverAlt} /> } -->
          </header>
          <div class="article-content">
            <PublicationDate publicationDate={article.data.publicationDate} />
            <h3>
              <a href={article.slug}>{article.data.title}</a>
            </h3>
            <p>{article.data.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</PageLayout>

<style>
  .article-grid {
    display: grid;
    gap: 2rem;
  }

  article {
    color: var(--secondary-text-color);
    background-color: var(--secondary-background-color);
    border: var(--standard-border);
  }

  .article-content {
    padding: 1rem;
  }

  .quote {
    color: #808080;
  }
</style>
